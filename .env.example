# ─── Supabase Configuration ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-real-service-role-key-here

# ─── Admin Session & Security ───────────────────────────────────────────
ADMIN_SESSION_SECRET=your-32-byte-random-session-secret-hash
ADMIN_SUPER_EMAIL=admin@mken.live
ADMIN_SUPER_PASSWORD_HASH=sha256-hashed-password-or-dev-password
ADMIN_SEED_PASSWORDS=development-only

# ─── Web Push (VAPID) ───────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@mken.live
