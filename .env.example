# ── Supabase (إلزامي لـ SaaS) ─────────────────────────────────────────────
# من: Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# مفتاح anon / publishable (للواجهة)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# مفتاح service_role (للـ API والتسجيل — سري، لا يُعرض في المتصفح)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── جلسات الإدارة والموظفين ───────────────────────────────────────────────
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# ── ZATCA + Trust BFF ─────────────────────────────────────────────────────
ZATCA_ENCRYPTION_KEY=replace-with-32-plus-char-secret
MKEN_TRUST_FUNCTIONS_BASE=https://YOUR_PROJECT_ID.functions.supabase.co
MKEN_COOKIE_DOMAIN=.mken.live

# ── اختياري ───────────────────────────────────────────────────────────────
CRON_SECRET=random-secret-for-cron
MOYASAR_SECRET_KEY=sk_test_...
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_SITE_URL=https://www.mken.live
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mken.live
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
