# ── Supabase (إلزامي لـ SaaS) ─────────────────────────────────────────────
# من: Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# مفتاح anon / publishable (للواجهة الأمامية)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# مفتاح service_role (للـ API والتسجيل — سري، لا يُعرض في المتصفح)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── بديل: مفاتيح Supabase الجديدة (sb_publishable_* / sb_secret_*) ────────
# إذا أضفت المتغير بالاسم sb_publishable_XXXX فسيتعرّف عليه النظام تلقائياً.
# يُفضّل استخدام الأسماء القياسية أعلاه في Vercel.

# ── اختياري ───────────────────────────────────────────────────────────────
ADMIN_PIN=mken2026
CRON_SECRET=random-secret-for-cron
MOYASAR_SECRET_KEY=sk_test_...
