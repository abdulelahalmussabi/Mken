# =============================================================================
# Mken Trust Engine — Edge Function secrets
# Set via: supabase secrets set KEY=value
# Or Supabase Dashboard → Edge Functions → Secrets
# =============================================================================

# Supabase (auto-injected on hosted; set locally for serve)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Cryptography (generate with: openssl rand -hex 32)
MKEN_SERVER_PEPPER=
MKEN_HMAC_SECRET=

# Authentica.sa — https://portal.authentica.sa/applications/
AUTHENTICA_API_KEY=
AUTHENTICA_TEMPLATE_ID=1

# Cloudflare Turnstile (fail-closed)
TURNSTILE_SECRET_KEY=

# Cookie — Edge may set these; production cookie Domain is applied by Vercel BFF
MKEN_COOKIE_DOMAIN=.mken.live
MKEN_DEVICE_COOKIE_NAME=mken_device_trust

# --- Vercel BFF (api/v1/trust.js) — set in Vercel Project Env, then Redeploy ---
# SUPABASE_URL=
# SUPABASE_KEY=          # anon / publishable
# MKEN_TRUST_FUNCTIONS_BASE=   # optional override of {SUPABASE_URL}/functions/v1
# MKEN_TRUST_MAX_AGE_SEC=5184000
