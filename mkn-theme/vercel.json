{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/custom-domains",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/review-funnel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ad-insights",
      "schedule": "15 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/google_business/callback",
      "destination": "/api/google-business/callback"
    },
    {
      "source": "/api/google_business",
      "destination": "/api/google-business"
    }
  ],
  "redirects": [
    {
      "source": "/dashboarc/:path*",
      "destination": "/dashboard/:path*",
      "permanent": true
    },
    {
      "source": "/themes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/theme",
      "destination": "/dashboard/themes",
      "permanent": true
    },
    {
      "source": "/staff.html",
      "destination": "/staff/login",
      "permanent": true
    },
    {
      "source": "/almahrusa",
      "destination": "/subscriber/almahrusa",
      "permanent": true
    },
    {
      "source": "/rewaq",
      "destination": "/subscriber/rewaq",
      "permanent": true
    }
  ]
}
