{
  "cleanUrls": false,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/custom-domains",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/review-funnel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ad-insights",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/instagram-posts",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/googleae07a7b850e5250d.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/googleae07a7b850e5250d.html",
      "destination": "/api/google-site-verification"
    },
    {
      "source": "/googleae07a7b850e5250d",
      "destination": "/api/google-site-verification"
    },
    {
      "source": "/api/google_business/callback",
      "destination": "/api/google-business/callback"
    },
    {
      "source": "/api/google_business",
      "destination": "/api/google-business"
    },
    {
      "source": "/api/cron-whatsapp",
      "destination": "/api/cron/whatsapp"
    }
  ],
  "redirects": [
    {
      "source": "/dashboarc/:path*",
      "destination": "/dashboard/:path*",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/license",
      "permanent": false
    },
    {
      "source": "/license-success.html",
      "destination": "/license/success",
      "permanent": false
    },
    {
      "source": "/themes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/theme",
      "destination": "/dashboard/themes",
      "permanent": true
    },
    {
      "source": "/staff.html",
      "destination": "/staff/login",
      "permanent": true
    },
    {
      "source": "/almahrusa",
      "destination": "/subscriber/almahrusa",
      "permanent": true
    },
    {
      "source": "/rewaq",
      "destination": "/subscriber/rewaq",
      "permanent": true
    }
  ]
}
