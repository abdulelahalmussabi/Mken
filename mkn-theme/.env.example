# Copy to .env.local for local dev. Do not commit .env.local.
# Production: Vercel → Project → Settings → Environment Variables, then Redeploy.

# Public (browser). Anon key only — RLS must stay enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Visitor Google / Apple sign-in (Supabase Auth). After enabling providers:
# Authentication → Providers → Google and Apple
# Redirect URLs must include:
#   http://localhost:3120/auth/callback
#   https://mken.live/auth/callback
#   https://*.mken.live/auth/callback
# Site URL: https://mken.live

# Server-only. Never use the NEXT_PUBLIC_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SESSION_SECRET=
ADMIN_SUPER_EMAIL=
# Optional if the super-admin user already exists in Supabase Auth.
ADMIN_SUPER_PASSWORD=
ADMIN_SUPER_PASSWORD_HASH=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud → APIs & Services → Credentials → OAuth client → Authorized redirect URIs
# exactly (www + hyphen). Branding verification does not register this URI.
# Secret is shown only once in Google Cloud; last 4 characters in the console are not enough.
# After rotating the secret, update this value AND Supabase Auth → Google provider, then Redeploy.
GOOGLE_REDIRECT_URI=https://www.mken.live/api/google-business/callback
GEMINI_API_KEY=
GOOGLE_MAPS_API_KEY=
CRON_SECRET=

# Meta Click-to-WhatsApp + Conversions API (server-only). After changing: Redeploy.
# Token: Business Settings → System users → Generate token
#   ads_management, ads_read, pages_manage_ads, pages_read_engagement, pages_show_list
# Platform-wide token only. Ad account ID and Page ID are stored per tenant in admin → ads campaigns.
META_ADS_ACCESS_TOKEN=
# Optional leftover from older deploys — ignored for publish. Use the per-tenant fields instead.
# META_AD_ACCOUNT_ID=
# META_PAGE_ID=

# Google Ads Local Search (server-only). After changing: Redeploy.
# Platform app credentials only. Each tenant connects their own Ads account via OAuth.
# Spend and billing stay on that Google Ads account's payment method.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Must be in Google Cloud OAuth client → Authorized redirect URIs.
# Default: $NEXT_PUBLIC_SITE_URL/api/ads/google/callback
# GOOGLE_ADS_REDIRECT_URI=
# Leftover — ignored. Do not put a platform-wide refresh token; tenants OAuth themselves.
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optional if different from GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (GBP).
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# Optional; tenant WhatsApp in settings is preferred
META_WHATSAPP_NUMBER=
# Events Manager → Data sources → Pixel ID
META_PIXEL_ID=
# Optional; falls back to META_ADS_ACCESS_TOKEN
META_CAPI_ACCESS_TOKEN=
