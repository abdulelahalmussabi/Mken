{
  "ignoreCommand": "[ \"$VERCEL_PROJECT_NAME\" = \"mken\" ] && echo \"[skip] legacy mken project\" && exit 0 || exit 1",
  "crons": [
    {
      "path": "/api/cron-whatsapp",
      "schedule": "0 9 * * *"
    }
  ],
  "build": {
    "env": {
      "CACHE_BREAKER": "force-rebuild-2026-11-16-mkn-rootdir"
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mken.live"
        }
      ],
      "destination": "/landing.html",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.mken.live"
        }
      ],
      "destination": "/landing.html",
      "permanent": false
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "host",
          "value": "mken.live"
        }
