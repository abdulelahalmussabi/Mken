{
  "framework": "nextjs",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/custom-domains",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/review-funnel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/ad-insights",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/cron/whatsapp",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/instagram-posts",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/google_business/callback",
      "destination": "/api/google-business/callback"
    },
    {
      "source": "/api/google_business",
      "destination": "/api/google-business"
    },
    {
      "source": "/api/cron-whatsapp",
      "destination": "/api/cron/whatsapp"
    },
    {
      "source": "/api/v1/zatca",
      "destination": "/api/zatca"
    },
    {
      "source": "/api/v1/auth/admin-login",
      "destination": "/api/admin/login"
    },
    {
      "source": "/api/v1/push-subscribe",
      "destination": "/api/v1/push?action=subscribe"
    },
    {
      "source": "/api/v1/push-notify",
      "destination": "/api/v1/push?action=notify"
    },
    {
      "source": "/api/v1/push-test",
      "destination": "/api/v1/push?action=test"
    }
  ],
  "redirects": [
    {
      "source": "/dashboarc/:path*",
      "destination": "/dashboard/:path*",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/license",
      "permanent": false
    },
    {
      "source": "/license-success.html",
      "destination": "/license/success",
      "permanent": false
    },
    {
      "source": "/themes",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dashboard/theme",
      "destination": "/dashboard/themes",
      "permanent": true
    },
    {
      "source": "/staff.html",
      "destination": "/staff/login",
      "permanent": true
    },
    {
      "source": "/almahrusa",
      "destination": "/subscriber/almahrusa",
      "permanent": true
    },
    {
      "source": "/rewaq",
      "destination": "/subscriber/rewaq",
      "permanent": true
    },
    {
      "source": "/signup.html",
      "destination": "/register",
      "permanent": false
    },
    {
      "source": "/track.html",
      "destination": "/track",
      "permanent": false
    },
    {
      "source": "/order.html",
      "destination": "/order",
      "permanent": false
    },
    {
      "source": "/admin.html",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/legal-portal.html",
      "destination": "/book?activity=legal",
      "permanent": false
    },
    {
      "source": "/football-coaching.html",
      "destination": "/book?activity=football",
      "permanent": false
    },
    {
      "source": "/coaching.html",
      "destination": "/book?activity=hockey",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/landing.html",
      "destination": "/",
      "permanent": false
    }
  ]
}
